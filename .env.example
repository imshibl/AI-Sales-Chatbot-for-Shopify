APP_NAME=Thai Naturals AI Shopping Assistant
STORE_NAME=Thai Naturals
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=

# Storage for conversations, carts, customers, and orders.
# Use STORAGE_BACKEND=sql with a SQLite or PostgreSQL URL for persistence.
STORAGE_BACKEND=memory
DATABASE_URL=

# Product source: memory, shopify, rest, or sql.
CATALOG_PROVIDER=memory
CATALOG_CACHE_SECONDS=60
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
CATALOG_API_URL=
CATALOG_API_TOKEN=
CATALOG_API_TYPE=rest
CATALOG_API_QUERY=
CATALOG_DATABASE_URL=
CATALOG_SQL_QUERY=

CHAT_HISTORY_LIMIT=20

PAYMENT_PROVIDER=dummy
ENABLE_DEMO_PAYMENT_ENDPOINT=true

CURRENCY=INR
DEFAULT_SHIPPING_FEE=50
DEFAULT_FREE_SHIPPING_THRESHOLD=1499
STORE_POLICIES_JSON=
